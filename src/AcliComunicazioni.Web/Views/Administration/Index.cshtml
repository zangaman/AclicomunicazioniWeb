@model AcliComunicazioni.Application.Administration.AdministrationDashboard
@{
    ViewData["Title"] = "Utenti e attività";
    var activeUsers = Model.Users.Count(user => !user.IsBlocked);
    var totalInserted = Model.Users.Sum(user => user.InsertedTrips);
    var totalDeleted = Model.Users.Sum(user => user.DeletedTrips);
}

<section class="page-heading compact-heading administration-heading">
    <div>
        <span class="eyebrow">Amministrazione</span>
        <h1>Utenti e attività</h1>
        <p>Riepilogo degli account e tracciamento delle operazioni sulle percorrenze.</p>
    </div>
    <a class="secondary-button" asp-controller="Home" asp-action="Index">Torna alle percorrenze</a>
</section>

<section class="admin-metrics" aria-label="Riepilogo amministrativo">
    <article><span>Utenti attivi</span><strong>@activeUsers</strong></article>
    <article><span>Utenti bloccati</span><strong>@Model.Users.Count(user => user.IsBlocked)</strong></article>
    <article><span>Percorrenze inserite</span><strong>@totalInserted</strong></article>
    <article><span>Eliminazioni tracciate</span><strong>@totalDeleted</strong></article>
</section>

<section class="dashboard-card admin-card">
    <div class="table-toolbar">
        <div>
            <span class="card-kicker">Account</span>
            <h2>Utenti</h2>
            <p>Le password non vengono mai visualizzate.</p>
        </div>
    </div>

    <div class="mileage-table-wrapper">
        <table class="mileage-table admin-table">
            <thead>
                <tr><th>ID</th><th>Utente</th><th>Nome</th><th>Permessi</th><th>Stato</th><th class="numeric-column">Inserimenti</th><th class="numeric-column">Eliminazioni</th></tr>
            </thead>
            <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td data-label="ID">@user.Id</td>
                    <td data-label="Utente"><strong>@user.Username</strong></td>
                    <td data-label="Nome">@user.DisplayName</td>
                    <td data-label="Permessi"><span class="user-badge">Livello @user.PermissionLevel</span></td>
                    <td data-label="Stato"><span class="@(user.IsBlocked ? "admin-status blocked" : "admin-status active")">@(user.IsBlocked ? "Bloccato" : "Attivo")</span></td>
                    <td data-label="Inserimenti" class="numeric-column">@user.InsertedTrips</td>
                    <td data-label="Eliminazioni" class="numeric-column">@user.DeletedTrips</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

<section class="dashboard-card admin-card">
    <div class="table-toolbar">
        <div>
            <span class="card-kicker">Audit</span>
            <h2>Ultime attività</h2>
            <p>Ultime 40 operazioni disponibili nel registro.</p>
        </div>
    </div>

    <div class="mileage-table-wrapper">
        <table class="mileage-table admin-table">
            <thead>
                <tr><th>Operazione</th><th>Data viaggio</th><th>Tragitto</th><th>Km</th><th>Inserito da</th><th>Eliminato da</th><th>Registrata il</th></tr>
            </thead>
            <tbody>
            @foreach (var activity in Model.RecentActivities)
            {
                <tr>
                    <td data-label="Operazione"><span class="@(activity.IsDeleted ? "admin-status blocked" : "admin-status active")">@(activity.IsDeleted ? "Eliminata" : "Registrata")</span></td>
                    <td data-label="Data viaggio">@activity.TripDate.ToString("dd/MM/yyyy")</td>
                    <td data-label="Tragitto"><strong class="route-name">@activity.Route</strong></td>
                    <td data-label="Km" class="numeric-column">@activity.StartKilometers:N0 → @activity.EndKilometers:N0</td>
                    <td data-label="Inserito da">@activity.InsertedBy</td>
                    <td data-label="Eliminato da">@(activity.DeletedBy ?? "—")</td>
                    <td data-label="Registrata il">@activity.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
