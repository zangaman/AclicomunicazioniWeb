<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcliComunicazioni</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mileage.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modern-ui.css" asp-append-version="true" />
</head>
<body>
    @{
        var displayName = User.FindFirst("display_name")?.Value ?? User.Identity?.Name ?? "Utente";
        var displayInitial = displayName.Trim().Length > 0 ? displayName.Trim()[0].ToString().ToUpperInvariant() : "U";
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var environmentLabel = Context.RequestServices.GetRequiredService<IConfiguration>()["ApplicationEnvironment:Label"];
        var showEnvironmentBanner = Context.RequestServices.GetRequiredService<IConfiguration>().GetValue<bool>("ApplicationEnvironment:ShowBanner");
    }
    <div class="app-shell">
        <aside class="app-sidebar" aria-label="Navigazione principale">
            <a class="app-sidebar-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">AC</span>
                <span><strong>Acli</strong><small>Comunicazioni</small></span>
            </a>

            <nav class="app-sidebar-nav">
                <a class="@(currentAction == "Index" ? "active" : null)" data-sidebar-home asp-controller="Home" asp-action="Index">
                    <svg class="app-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1V10z"/></svg>
                    <span>Home</span>
                </a>
                <a data-sidebar-trips asp-controller="Home" asp-action="Index" asp-fragment="latest-trips">
                    <svg class="app-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19c2.5-3 4.8-4.5 7-4.5s4.5 1.5 7 4.5M8.5 8.5a3.5 3.5 0 1 0 7 0c0-2.7-3.5-6-3.5-6s-3.5 3.3-3.5 6z"/><circle cx="12" cy="8.5" r=".8"/></svg>
                    <span>Percorrenze</span>
                </a>
                <a class="@(currentAction == "MileageReport" ? "active" : null)" asp-controller="Home" asp-action="MileageReport">
                    <svg class="app-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 20V10M12 20V4M19 20v-7M3 20h18"/></svg>
                    <span>Report</span>
                </a>
            </nav>

            <div class="app-sidebar-footer">
                <a href="#quick-entry" class="sidebar-support-link">
                    <svg class="app-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.8 9a2.3 2.3 0 1 1 3.7 1.8c-.9.6-1.5 1-1.5 2.2M12 17h.01"/></svg>
                    <span>Aiuto e supporto</span>
                    <svg class="app-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                </a>
                <div class="sidebar-vehicle">
                    <span>Gestione trasferte</span>
                    <strong>Furgone ACLI</strong>
                </div>
            </div>
        </aside>

        <div class="app-workspace">
            <header class="topbar">
                <div class="topbar-content">
                    <a class="topbar-brand" asp-controller="Home" asp-action="Index">
                        <span class="brand-mark small">AC</span>
                        <strong>AcliComunicazioni</strong>
                    </a>

                    @if (showEnvironmentBanner && !string.IsNullOrWhiteSpace(environmentLabel))
                    {
                        <div class="environment-banner" role="status">
                            <span>Ambiente </span>@environmentLabel
                        </div>
                    }

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="user-area">
                            <button type="button" class="desktop-notification-button" aria-label="Notifiche">
                                <svg class="app-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg>
                            </button>

                            <details class="desktop-account-menu">
                                <summary aria-label="Apri menu utente">
                                    <span class="desktop-user-avatar">@displayInitial</span>
                                    <span class="desktop-user-name">@displayName</span>
                                    <svg class="app-icon desktop-user-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 9 5 5 5-5"/></svg>
                                </summary>
                                <div class="desktop-account-popover">
                                    <span>Utente collegato</span>
                                    <strong>@displayName</strong>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit">
                                            <svg class="app-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 17l5-5-5-5M15 12H3M15 4h4a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-4"/></svg>
                                            Esci
                                        </button>
                                    </form>
                                </div>
                            </details>

                            <details class="mobile-account-menu">
                                <summary aria-label="Apri menu utente">
                                    <svg class="app-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
                                </summary>
                                <div class="mobile-account-popover">
                                    <span>Utente collegato</span>
                                    <strong>@displayName</strong>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit">Esci</button>
                                    </form>
                                </div>
                            </details>
                        </div>
                    }
                </div>
            </header>
            <main class="main-content">
                @RenderBody()
            </main>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
    @if (currentAction == "Index")
    {
        <script>
            (() => {
                const homeLink = document.querySelector('[data-sidebar-home]');
                const tripsLink = document.querySelector('[data-sidebar-trips]');

                const syncSidebarSection = () => {
                    if (!homeLink || !tripsLink) return;
                    const isTripsSection = window.location.hash === '#latest-trips';
                    homeLink.classList.toggle('active', !isTripsSection);
                    tripsLink.classList.toggle('active', isTripsSection);
                };

                syncSidebarSection();
                window.addEventListener('hashchange', syncSidebarSection);
            })();
        </script>
    }
</body>
</html>
