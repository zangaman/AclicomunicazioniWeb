<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcliComunicazioni</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mileage.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <div class="container topbar-content">
            <a class="topbar-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark small">AC</span>
                <strong>AcliComunicazioni</strong>
            </a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="user-area">
                    <div class="user-copy">
                        <span>Connesso come</span>
                        <strong>@(User.FindFirst("display_name")?.Value ?? User.Identity.Name)</strong>
                    </div>
                    <a class="secondary-button desktop-admin-link" asp-controller="Administration" asp-action="Index">Utenti</a>
                    <form class="desktop-logout" asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="secondary-button">Esci</button>
                    </form>

                    <details class="mobile-account-menu">
                        <summary aria-label="Apri menu utente">
                            <svg class="app-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
                        </summary>
                        <div class="mobile-account-popover">
                            <span>Utente collegato</span>
                            <strong>@(User.FindFirst("display_name")?.Value ?? User.Identity.Name)</strong>
                            <a class="mobile-admin-link" asp-controller="Administration" asp-action="Index">Utenti e attività</a>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit">Esci</button>
                            </form>
                        </div>
                    </details>
                </div>
            }
        </div>
    </header>
    <main class="container main-content">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>