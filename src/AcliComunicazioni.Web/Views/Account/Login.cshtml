@model AcliComunicazioni.Web.Models.Account.LoginViewModel
@{
    ViewData["Title"] = "Accesso";
    Layout = null;
    var showDomainForm = !Model.ShowDualLoginButtons || !ViewData.ModelState.IsValid;
}
<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1786b4" />
    <title>Accesso - AcliComunicazioni</title>
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="~/images/logo-acli.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/icons/favicon-32.png" />
    <link rel="shortcut icon" href="~/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/icons/apple-touch-icon.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page">
    <main class="login-shell">
        <section class="login-experience" aria-labelledby="login-title">
            <aside class="login-story" aria-label="ACLI Trentine">
                <div class="login-story-brand">
                    <span class="login-official-logo">
                        <img src="~/images/logo-acli.svg" alt="" />
                    </span>
                    <div>
                        <strong>ACLI Trentine</strong>
                        <span>Servizi interni</span>
                    </div>
                </div>

                <div class="login-story-copy">
                    <h2>AcliComunicazioni</h2>
                    <span class="login-story-kicker">Portale dei servizi interni</span>
                    <p>Il punto di accesso agli strumenti di lavoro quotidiani.</p>
                </div>
            </aside>

            <section class="login-panel">
                <div class="login-mobile-brand">
                    <span class="login-mobile-official-logo">
                        <img src="~/images/logo-acli.svg" alt="" />
                    </span>
                    <span>
                        <strong>AcliComunicazioni</strong>
                        <small>ACLI Trentine</small>
                    </span>
                </div>

                <div class="login-heading">
                    <span class="eyebrow">Area riservata</span>
                    <h1 id="login-title">Accedi al portale</h1>
                    <p>Scegli il metodo di accesso aziendale disponibile.</p>
                </div>

                @if (Model.ShowWindowsLogin)
                {
                    <a asp-action="WindowsLogin"
                       asp-route-returnUrl="@Model.ReturnUrl"
                       class="primary-button login-submit">
                        <span>Accedi con Windows</span>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M14 7l5 5-5 5"/></svg>
                    </a>
                }

                @if (Model.ShowDualLoginButtons)
                {
                    <div class="login-method-divider" role="separator">
                        <span>oppure</span>
                    </div>

                    <button type="button"
                            id="domain-login-toggle"
                            class="primary-button login-submit"
                            aria-controls="domain-login-form"
                            aria-expanded="@(showDomainForm ? "true" : "false")">
                        <span>Accedi con credenziali dominio</span>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M14 7l5 5-5 5"/></svg>
                    </button>
                }

                @if (!Model.ShowWindowsLogin || Model.UsesDomainCredentials)
                {
                    @if (Model.ShowWindowsLogin && !Model.ShowDualLoginButtons)
                    {
                        <div class="login-method-divider" role="separator">
                            <span>oppure</span>
                        </div>
                    }

                    <form asp-action="Login"
                          method="post"
                          class="login-form"
                          id="domain-login-form"
                          style="@(showDomainForm ? null : "display:none;")">
                        @Html.AntiForgeryToken()
                        <input asp-for="ReturnUrl" type="hidden" />

                        <div asp-validation-summary="ModelOnly" class="validation-summary login-validation"></div>

                        <div class="form-field login-field">
                            <label asp-for="Username"></label>
                            <div class="login-input-wrap">
                                <svg class="login-input-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
                                <input asp-for="Username" autocomplete="username" placeholder="nome.cognome" autofocus="@(!Model.ShowWindowsLogin)" />
                            </div>
                            <span asp-validation-for="Username" class="field-error"></span>
                        </div>

                        <div class="form-field login-field">
                            <label asp-for="Password"></label>
                            <div class="login-input-wrap">
                                <svg class="login-input-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                                <input asp-for="Password" autocomplete="current-password" placeholder="Inserisci la password" />
                                <button type="button" class="password-toggle" aria-label="Mostra password" aria-pressed="false">
                                    <svg class="password-show-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z"/><circle cx="12" cy="12" r="2.5"/></svg>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="field-error"></span>
                        </div>

                        <label class="remember-row">
                            <input asp-for="RememberMe" />
                            <span>Mantieni l’accesso su questo dispositivo</span>
                        </label>

                        <button type="submit" class="primary-button login-submit">
                            <span>@(Model.UsesDomainCredentials ? "Accedi con le credenziali aziendali" : "Accedi")</span>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M14 7l5 5-5 5"/></svg>
                        </button>
                    </form>
                }

                <div class="login-security-note">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                    <span>Accesso protetto e riservato al personale autorizzato.</span>
                </div>
            </section>
        </section>
    </main>
    <script>
        (() => {
            const domainButton = document.getElementById('domain-login-toggle');
            const domainForm = document.getElementById('domain-login-form');

            if (domainButton && domainForm) {
                domainButton.addEventListener('click', () => {
                    const isHidden = domainForm.style.display === 'none';
                    domainForm.style.display = isHidden ? '' : 'none';
                    domainButton.setAttribute('aria-expanded', isHidden.toString());

                    if (isHidden) {
                        const username = document.getElementById('Username');
                        if (username) username.focus();
                    }
                });
            }

            const button = document.querySelector('.password-toggle');
            const password = document.getElementById('Password');
            if (!button || !password) return;

            button.addEventListener('click', () => {
                const show = password.type === 'password';
                password.type = show ? 'text' : 'password';
                button.setAttribute('aria-pressed', show.toString());
                button.setAttribute('aria-label', show ? 'Nascondi password' : 'Mostra password');
                password.focus();
            });
        })();
    </script>
    <script src="~/js/pwa.js" asp-append-version="true"></script>
</body>
</html>
