@model AcliComunicazioni.Application.Mileage.MileageDashboard

@{
    ViewData["Title"] = "Percorrenze";
    var cultura = new System.Globalization.CultureInfo("it-IT");
    var conducenteCorrente = User.FindFirst("display_name")?.Value
        ?? User.Identity?.Name
        ?? "Utente collegato";
    var gapsCount = Model.RecentEntries.Count(entry => entry.GapKilometers > 0);
    var missingKilometers = Model.RecentEntries.Sum(entry => entry.GapKilometers);
}

<section class="page-heading">
    <div>
        <span class="eyebrow">Gestione trasferte</span>
        <h1>Percorrenze</h1>
        <p>Registra i chilometri iniziali e finali. Il conducente viene identificato automaticamente dall’utente collegato.</p>
    </div>
    <a class="primary-button page-action" href="#quick-entry">＋ Nuova percorrenza</a>
</section>

@if (TempData["MileageSuccess"] is string successMessage)
{
    <div class="alert alert-success" role="status">@successMessage</div>
}

@if (TempData["MileageError"] is string errorMessage)
{
    <div class="alert alert-error" role="alert">@errorMessage</div>
}

<section class="dashboard-grid mileage-dashboard-grid">
    <article class="dashboard-card summary-card">
        <div class="card-heading-row">
            <div>
                <span class="card-kicker">Situazione attuale</span>
                <h2>Riepilogo del mezzo</h2>
            </div>
            <span class="summary-icon" aria-hidden="true">↗</span>
        </div>

        <div class="summary-main-value">
            <span>Ultimo chilometraggio</span>
            <strong>@(Model.CurrentKilometers?.ToString("N0", cultura) ?? "—") <small>km</small></strong>
        </div>

        <dl class="vehicle-stats mileage-summary-stats">
            <div><dt>Ultima percorrenza</dt><dd>@(Model.LastTripDate?.ToString("dd/MM/yyyy") ?? "Nessun dato")</dd></div>
            <div><dt>Ultimo tragitto</dt><dd>@(Model.RecentEntries.FirstOrDefault()?.Route ?? "—")</dd></div>
            <div><dt>Ultima distanza</dt><dd>@(Model.RecentEntries.FirstOrDefault()?.DistanceKilometers.ToString("N0", cultura) ?? "—") km</dd></div>
            <div><dt>Ultimo conducente</dt><dd>@(Model.RecentEntries.FirstOrDefault()?.InsertedBy ?? "—")</dd></div>
        </dl>
    </article>

    <article class="dashboard-card" id="quick-entry">
        <div class="card-heading-row"><div><span class="card-kicker">Inserimento rapido</span><h2>Nuova percorrenza</h2></div></div>

        <form asp-controller="Home" asp-action="AddMileage" method="post" class="quick-entry-form" id="mileage-form">
            @Html.AntiForgeryToken()
            <div class="form-row">
                <div class="form-field">
                    <label for="tripDate">Data</label>
                    <input id="tripDate" name="tripDate" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="form-field">
                    <label for="startKilometers">Km iniziali</label>
                    <input id="startKilometers" name="startKilometers" type="number" min="0" step="1" value="@Model.CurrentKilometers" required />
                    <small class="field-help">L’ultimo valore è proposto automaticamente, ma puoi modificarlo.</small>
                </div>
            </div>

            <div id="gap-warning" class="gap-warning" hidden><strong>Attenzione: possibile tratto non registrato</strong><span></span></div>

            <div class="form-field">
                <label for="endKilometers">Km finali</label>
                <input id="endKilometers" name="endKilometers" type="number" min="@(Model.CurrentKilometers ?? 0)" step="1" required />
            </div>

            <div class="distance-preview" id="distance-preview" aria-live="polite"><span>Km percorsi</span><strong>—</strong></div>

            <div class="form-field">
                <label for="route">Tragitto</label>
                <input id="route" name="route" type="text" maxlength="200" placeholder="es. Trento - Rovereto" required />
            </div>

            <div class="form-field">
                <label for="description">Dettaglio <span class="optional-label">facoltativo</span></label>
                <textarea id="description" name="description" maxlength="500" rows="3" placeholder="Motivo della trasferta o note utili"></textarea>
            </div>

            <div class="driver-detail" aria-label="Conducente della percorrenza">
                <span class="driver-detail-label">Conducente</span>
                <strong>@conducenteCorrente</strong>
                <small>Assegnato automaticamente in base all’utente collegato.</small>
            </div>

            <button class="primary-button" type="submit">Salva percorrenza</button>
        </form>
    </article>
</section>

<section class="dashboard-card activity-card trips-card" id="latest-trips">
    <div class="table-toolbar">
        <div>
            <span class="card-kicker">Storico condiviso</span>
            <h2>Ultime percorrenze</h2>
            <p>
                @Model.RecentEntries.Count registrazioni visualizzate
                @if (gapsCount > 0)
                {
                    <span> · <strong>@gapsCount slot vuoti</strong> · @missingKilometers.ToString("N0", cultura) km da verificare</span>
                }
            </p>
        </div>

        <div class="export-actions" aria-label="Esporta percorrenze">
            <a class="secondary-button export-button" asp-action="ExportMileage" asp-route-format="csv">CSV / Excel</a>
            <a class="secondary-button export-button" asp-action="ExportMileage" asp-route-format="json">JSON</a>
            <a class="secondary-button export-button" asp-action="ExportMileage" asp-route-format="xml">XML</a>
            <button class="secondary-button export-button" type="button" onclick="window.print()">Stampa / PDF</button>
        </div>
    </div>

    @if (gapsCount > 0)
    {
        <div class="alert alert-error" role="alert">Sono presenti @missingKilometers.ToString("N0", cultura) km non registrati in @gapsCount intervalli. Usa “Inserisci tratto” per completare lo storico.</div>
    }

    @if (Model.RecentEntries.Count == 0)
    {
        <div class="empty-state"><span class="empty-state-icon" aria-hidden="true">↗</span><div><h3>Nessuna percorrenza presente</h3><p>Inserisci la prima percorrenza dal modulo qui sopra.</p></div></div>
    }
    else
    {
        <div class="table-responsive mileage-table-wrapper">
            <table class="mileage-table">
                <thead>
                    <tr>
                        <th>Data</th><th>Tragitto</th><th class="numeric-column">Km iniziali</th><th class="numeric-column">Km finali</th><th class="numeric-column">Percorsi</th><th>Conducente</th><th>Segnalazioni</th><th class="actions-column"><span class="visually-hidden">Azioni</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.RecentEntries)
                    {
                        @if (entry.GapKilometers > 0 && entry.PreviousEndKilometers.HasValue)
                        {
                            <tr class="row-with-gap missing-mileage-row">
                                <td data-label="Data"><span title="Data da verificare">Da verificare</span></td>
                                <td data-label="Tragitto"><strong class="route-name">⚠ Tratto non registrato</strong><small class="route-description">Slot @entry.PreviousEndKilometers.Value.ToString("N0", cultura) – @entry.StartKilometers.ToString("N0", cultura)</small></td>
                                <td data-label="Km iniziali" class="numeric-column">@entry.PreviousEndKilometers.Value.ToString("N0", cultura)</td>
                                <td data-label="Km finali" class="numeric-column">@entry.StartKilometers.ToString("N0", cultura)</td>
                                <td data-label="Percorsi" class="numeric-column"><span class="gap-badge">@entry.GapKilometers.ToString("N0", cultura) km</span></td>
                                <td data-label="Conducente"><span class="user-badge">Da assegnare</span></td>
                                <td data-label="Segnalazioni"><span class="gap-badge">Percorrenza mancante</span></td>
                                <td class="actions-column"><button type="button" class="table-action fill-gap-button" data-start="@entry.PreviousEndKilometers.Value" data-end="@entry.StartKilometers" data-date="@entry.TripDate.ToString("yyyy-MM-dd")">Inserisci tratto</button></td>
                            </tr>
                        }

                        <tr>
                            <td data-label="Data"><time datetime="@entry.TripDate.ToString("yyyy-MM-dd")">@entry.TripDate.ToString("dd/MM/yyyy")</time></td>
                            <td data-label="Tragitto">
                                <strong class="route-name">@entry.Route</strong>
                                @if (!string.IsNullOrWhiteSpace(entry.Description))
                                {
                                    <small class="route-description">@entry.Description</small>
                                }
                            </td>
                            <td data-label="Km iniziali" class="numeric-column">@entry.StartKilometers.ToString("N0", cultura)</td>
                            <td data-label="Km finali" class="numeric-column">@entry.EndKilometers.ToString("N0", cultura)</td>
                            <td data-label="Percorsi" class="numeric-column"><span class="distance-badge">@entry.DistanceKilometers.ToString("N0", cultura) km</span></td>
                            <td data-label="Conducente"><span class="user-badge">@entry.InsertedBy</span></td>
                            <td data-label="Segnalazioni"><span class="no-gap">Registrata</span></td>
                            <td class="actions-column">
                                <a class="table-action" asp-action="EditMileage" asp-route-id="@entry.Id" aria-label="Modifica @entry.Route">Modifica</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@section Scripts
{
    <script>
        (() => {
            const currentKilometers = @(Model.CurrentKilometers?.ToString() ?? "null");
            const form = document.getElementById('mileage-form');
            const tripDate = document.getElementById('tripDate');
            const start = document.getElementById('startKilometers');
            const end = document.getElementById('endKilometers');
            const route = document.getElementById('route');
            const description = document.getElementById('description');
            const preview = document.querySelector('#distance-preview strong');
            const gapWarning = document.getElementById('gap-warning');
            const gapText = gapWarning.querySelector('span');
            const formatter = new Intl.NumberFormat('it-IT');

            const updateValues = () => {
                const startValue = Number(start.value);
                const endValue = Number(end.value);
                end.min = start.value || '0';
                preview.textContent = Number.isFinite(startValue) && Number.isFinite(endValue) && endValue >= startValue
                    ? formatter.format(endValue - startValue) + ' km'
                    : '—';

                if (currentKilometers !== null && Number.isFinite(startValue) && startValue > currentKilometers) {
                    gapText.textContent = `Dall’ultima percorrenza risultano ${formatter.format(startValue - currentKilometers)} km senza registrazione. Puoi comunque salvare.`;
                    gapWarning.hidden = false;
                } else {
                    gapWarning.hidden = true;
                }
            };

            document.querySelectorAll('.fill-gap-button').forEach(button => {
                button.addEventListener('click', () => {
                    start.value = button.dataset.start;
                    end.value = button.dataset.end;
                    tripDate.value = button.dataset.date;
                    route.value = '';
                    description.value = `Completamento dello slot chilometrico ${formatter.format(Number(button.dataset.start))} - ${formatter.format(Number(button.dataset.end))}.`;
                    updateValues();
                    form.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    window.setTimeout(() => route.focus(), 450);
                });
            });

            start.addEventListener('input', updateValues);
            end.addEventListener('input', updateValues);
            updateValues();
        })();
    </script>
}
