@model AcliComunicazioni.Application.Mileage.MileageDashboard

@{
    ViewData["Title"] = "Percorrenze";
    var cultura = new System.Globalization.CultureInfo("it-IT");
    var ultimaPercorrenza = Model.RecentEntries.FirstOrDefault();
    var kmPartenzaProposti = Model.CurrentKilometers ?? 0;
}

<h1>Percorrenze</h1>
<p>Registra rapidamente uno spostamento e consulta le ultime percorrenze.</p>

@if (TempData["MileageSuccess"] is string successMessage)
{
    <div class="alert alert-success" role="status">@successMessage</div>
}

@if (TempData["MileageError"] is string errorMessage)
{
    <div class="alert alert-error" role="alert">@errorMessage</div>
}

<section class="dashboard-grid">
    <article class="dashboard-card">
        <h2>Riepilogo</h2>
        <dl class="vehicle-stats">
            <div>
                <dt>Ultimo chilometraggio</dt>
                <dd>@(Model.CurrentKilometers?.ToString("N0", cultura) ?? "—") km</dd>
            </div>
            <div>
                <dt>Ultima percorrenza</dt>
                <dd>@(Model.LastTripDate?.ToString("dd/MM/yyyy") ?? "Nessun dato")</dd>
            </div>
            @if (ultimaPercorrenza is not null)
            {
                <div>
                    <dt>Ultimo tragitto</dt>
                    <dd>@ultimaPercorrenza.Route</dd>
                </div>
                <div>
                    <dt>Km percorsi</dt>
                    <dd>@ultimaPercorrenza.DistanceKilometers.ToString("N0", cultura) km</dd>
                </div>
            }
        </dl>
    </article>

    <article class="dashboard-card" id="quick-entry">
        <h2>Nuova percorrenza</h2>

        <form asp-controller="Home" asp-action="AddMileage" method="post" class="quick-entry-form">
            @Html.AntiForgeryToken()

            <div class="form-field">
                <label for="tripDate">Data</label>
                <input id="tripDate"
                       name="tripDate"
                       type="date"
                       value="@DateTime.Today.ToString("yyyy-MM-dd")"
                       max="@DateTime.Today.ToString("yyyy-MM-dd")"
                       required />
            </div>

            <div class="form-field">
                <label for="startKilometers">Km partenza</label>
                <input id="startKilometers"
                       name="startKilometers"
                       type="number"
                       inputmode="numeric"
                       min="0"
                       step="1"
                       value="@kmPartenzaProposti"
                       required />
                @if (Model.CurrentKilometers.HasValue)
                {
                    <small>Proposto dall'ultimo chilometraggio registrato.</small>
                }
            </div>

            <div class="form-field">
                <label for="endKilometers">Km arrivo</label>
                <input id="endKilometers"
                       name="endKilometers"
                       type="number"
                       inputmode="numeric"
                       min="@kmPartenzaProposti"
                       step="1"
                       placeholder="es. @(kmPartenzaProposti + 50)"
                       required
                       autofocus />
            </div>

            <div class="form-field">
                <label>Km percorsi</label>
                <output id="distancePreview" aria-live="polite">—</output>
            </div>

            <div class="form-field">
                <label for="route">Tragitto</label>
                <input id="route"
                       name="route"
                       type="text"
                       maxlength="200"
                       placeholder="es. Trento - Rovereto"
                       autocomplete="off"
                       required />
            </div>

            <div class="form-field">
                <label for="description">Descrizione <span aria-hidden="true">(facoltativa)</span></label>
                <textarea id="description"
                          name="description"
                          maxlength="500"
                          rows="3"
                          placeholder="es. Riunione presso la sede"></textarea>
            </div>

            <button class="primary-button" type="submit">Salva percorrenza</button>
        </form>
    </article>
</section>

<section class="dashboard-card activity-card">
    <div class="card-heading-row">
        <h2>Ultime percorrenze</h2>
        <span>@Model.RecentEntries.Count elementi</span>
    </div>

    @if (Model.RecentEntries.Count == 0)
    {
        <p>Nessuna percorrenza presente. Inserisci la prima percorrenza dal modulo qui sopra.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Data</th>
                        <th>Tragitto</th>
                        <th>Partenza</th>
                        <th>Arrivo</th>
                        <th>Percorsi</th>
                        <th>Descrizione</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.RecentEntries)
                    {
                        <tr>
                            <td>@entry.TripDate.ToString("dd/MM/yyyy")</td>
                            <td><strong>@entry.Route</strong></td>
                            <td>@entry.StartKilometers.ToString("N0", cultura)</td>
                            <td>@entry.EndKilometers.ToString("N0", cultura)</td>
                            <td><strong>@entry.DistanceKilometers.ToString("N0", cultura) km</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(entry.Description) ? "—" : entry.Description)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@section Scripts {
    <script>
        (() => {
            const startInput = document.getElementById('startKilometers');
            const endInput = document.getElementById('endKilometers');
            const preview = document.getElementById('distancePreview');

            if (!startInput || !endInput || !preview) {
                return;
            }

            const updateDistance = () => {
                const start = Number.parseInt(startInput.value, 10);
                const end = Number.parseInt(endInput.value, 10);

                endInput.min = Number.isFinite(start) ? start.toString() : '0';

                if (!Number.isFinite(start) || !Number.isFinite(end)) {
                    preview.textContent = '—';
                    return;
                }

                const distance = end - start;
                preview.textContent = distance >= 0
                    ? `${distance.toLocaleString('it-IT')} km`
                    : 'I km di arrivo devono essere maggiori o uguali alla partenza';
            };

            startInput.addEventListener('input', updateDistance);
            endInput.addEventListener('input', updateDistance);
            updateDistance();
        })();
    </script>
}
