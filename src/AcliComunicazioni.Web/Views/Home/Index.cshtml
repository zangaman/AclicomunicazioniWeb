@model AcliComunicazioni.Web.Models.MileageHistoryViewModel

@{
    ViewData["Title"] = "Percorrenze";
    var cultura = new System.Globalization.CultureInfo("it-IT");
    var conducenteCorrente = User.FindFirst("display_name")?.Value
        ?? User.Identity?.Name
        ?? "Utente collegato";
    var gapsCount = Model.Dashboard.RecentEntries.Count(entry => entry.GapKilometers > 0);
    var missingKilometers = Model.Dashboard.RecentEntries.Sum(entry => entry.GapKilometers);
    var firstGap = Model.Dashboard.RecentEntries
        .Where(entry => entry.GapKilometers > 0 && entry.PreviousEndKilometers.HasValue)
        .OrderByDescending(entry => entry.StartKilometers)
        .FirstOrDefault();
    var summaryYear = Model.SelectedYear ?? DateTime.Today.Year;
    var monthlyTotals = Model.AllEntries
        .Where(entry => entry.TripDate.Year == summaryYear)
        .GroupBy(entry => entry.TripDate.Month)
        .OrderBy(group => group.Key)
        .Select(group => new { Month = group.Key, Kilometers = group.Sum(entry => entry.DistanceKilometers), Trips = group.Count() })
        .ToArray();
    var annualTotals = Model.AllEntries
        .GroupBy(entry => entry.TripDate.Year)
        .OrderByDescending(group => group.Key)
        .Select(group => new { Year = group.Key, Kilometers = group.Sum(entry => entry.DistanceKilometers), Trips = group.Count() })
        .Take(6)
        .ToArray();
}

<section class="page-heading">
    <div>
        <span class="eyebrow">Gestione trasferte</span>
        <h1>Percorrenze</h1>
        <p>Registra i chilometri iniziali e finali. Il conducente viene identificato automaticamente dall’utente collegato.</p>
    </div>
    <a class="primary-button page-action" href="#quick-entry">＋ Nuova percorrenza</a>
</section>

@if (TempData["MileageSuccess"] is string successMessage)
{
    <div class="alert alert-success" role="status">@successMessage</div>
}

@if (TempData["MileageError"] is string errorMessage)
{
    <div class="alert alert-error" role="alert">@errorMessage</div>
}

<section class="mobile-mileage-app">
    <section class="mobile-screen mobile-home-screen" data-mobile-screen="home">
        <header class="mobile-operation-heading" aria-label="Mezzo selezionato">
            <div>
                <span>Gestione trasferte</span>
                <h1>Furgone ACLI</h1>
                <p>Mezzo operativo</p>
            </div>
            <span class="mobile-operation-status"><i aria-hidden="true"></i> Attivo</span>
        </header>

        <article class="mobile-odometer-hero">
            <span>Chilometraggio attuale</span>
            <strong>@(Model.Dashboard.CurrentKilometers?.ToString("N0", cultura) ?? "—") <small>km</small></strong>
            <p>Aggiornato al @(Model.Dashboard.LastTripDate?.ToString("dd/MM/yyyy") ?? "—")</p>
            <div class="mobile-hero-ring" aria-hidden="true">
                <svg class="app-icon" viewBox="0 0 24 24">
                    <path d="M4 17a8 8 0 0 1 16 0M6 12l-1.5-1M9 9l-.7-1.7M12 8V6M15 9l.7-1.7M18 12l1.5-1M12 17l4-4"/>
                    <circle cx="12" cy="17" r="1.4"/>
                </svg>
            </div>

            @if (gapsCount > 0)
            {
                <button type="button" class="mobile-hero-gap" id="mobile-gap-action" aria-label="Completa il primo tratto chilometrico mancante">
                    <svg class="app-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4 3 20h18L12 4zM12 9v5M12 17h.01"/></svg>
                    <span>@missingKilometers.ToString("N0", cultura) km da completare</span>
                    <svg class="app-icon mobile-hero-gap-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                </button>
            }

        </article>

        <button type="button" class="mobile-add-mileage mobile-home-register" id="mobile-add-mileage" aria-label="Aggiungi percorrenza" aria-expanded="false">
            <svg class="app-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            <span>Registra viaggio</span>
        </button>

        <section class="mobile-activity-log">
            <header>
                <h2>Attività recenti</h2>
                <button type="button" class="mobile-view-all" data-mobile-open-trips>Vedi tutte</button>
            </header>

            <div class="mobile-activity-list">
            @foreach (var entry in Model.Dashboard.RecentEntries
                .OrderByDescending(entry => entry.EndKilometers)
                .ThenByDescending(entry => entry.TripDate)
                .Take(3))
            {
                <a class="mobile-trip-row" asp-action="EditMileage" asp-route-id="@entry.Id">
                    <span class="mobile-trip-icon" aria-hidden="true"><svg class="app-icon vehicle-icon" viewBox="0 0 24 24"><path d="M4 15.5h16M5.5 15.5l1.2-5.2A2 2 0 0 1 8.65 8.8h6.7a2 2 0 0 1 1.95 1.5l1.2 5.2M7 12h10"/><circle cx="7" cy="17.5" r="1.5"/><circle cx="17" cy="17.5" r="1.5"/></svg></span>
                    <span class="mobile-trip-copy">
                        <strong>@entry.Route</strong>
                        <small>@entry.TripDate.ToString("dd/MM/yyyy") · @entry.StartKilometers.ToString("N0", cultura) → @entry.EndKilometers.ToString("N0", cultura)</small>
                    </span>
                    <span class="mobile-trip-distance">@entry.DistanceKilometers.ToString("N0", cultura) km</span>
                    <svg class="app-icon mobile-trip-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                </a>
            }
            </div>
        </section>
    </section>

    <section class="mobile-screen mobile-trips-screen" data-mobile-screen="trips" hidden>
        <header class="mobile-trips-heading">
            <span>Gestione trasferte</span>
            <h1>Viaggi</h1>
            <p>Storico delle percorrenze</p>
        </header>

        <p class="mobile-trips-summary">
            <strong>@Model.Dashboard.RecentEntries.Count registrazioni</strong>
            @if (gapsCount > 0)
            {
                <span>· @missingKilometers.ToString("N0", cultura) km da verificare</span>
            }
            else
            {
                <span>· Sequenza completa</span>
            }
        </p>

        <section class="period-kilometers-summary mobile-period-kilometers">
            <header><h2>Riepilogo km</h2><span>@summaryYear</span></header>
            <div class="period-kilometers-columns">
                <article>
                    <h3>Per mese</h3>
                    @if (monthlyTotals.Length == 0)
                    {
                        <p>Nessun viaggio nel @summaryYear.</p>
                    }
                    else
                    {
                        @foreach (var total in monthlyTotals)
                        {
                            <div class="period-kilometers-row"><span>@cultura.DateTimeFormat.GetAbbreviatedMonthName(total.Month)</span><strong>@total.Kilometers.ToString("N0", cultura) km</strong></div>
                        }
                    }
                </article>
                <article>
                    <h3>Per anno</h3>
                    @foreach (var total in annualTotals)
                    {
                        <div class="period-kilometers-row"><span>@total.Year</span><strong>@total.Kilometers.ToString("N0", cultura) km</strong></div>
                    }
                </article>
            </div>
        </section>

        <form class="history-filter mobile-history-filter" method="get" asp-action="Index" aria-label="Filtra lo storico per periodo">
            <label>
                <span>Anno</span>
                <select name="year">
                    <option value="">Tutti</option>
                    @foreach (var availableYear in Model.AvailableYears)
                    {
                        <option value="@availableYear" selected="@(Model.SelectedYear == availableYear ? "selected" : null)">@availableYear</option>
                    }
                </select>
            </label>
            <label>
                <span>Mese</span>
                <select name="month">
                    <option value="">Tutti i mesi</option>
                    @for (var monthNumber = 1; monthNumber <= 12; monthNumber++)
                    {
                        <option value="@monthNumber" selected="@(Model.SelectedMonth == monthNumber ? "selected" : null)">@cultura.DateTimeFormat.GetMonthName(monthNumber)</option>
                    }
                </select>
            </label>
            <button type="submit">Mostra</button>
        </form>
        @if (!Model.IsAllHistory)
        {
            <a class="mobile-history-all" asp-action="Index" asp-route-showAll="true">Visualizza tutto lo storico</a>
        }
        else
        {
            <a class="mobile-history-all" asp-action="Index">Torna al mese corrente</a>
        }

        <label class="mobile-trip-search">
            <svg class="app-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
            <span class="visually-hidden">Cerca tragitto</span>
            <input type="search" id="mobile-trip-search" placeholder="Cerca tragitto" autocomplete="off" />
        </label>

        <div class="mobile-trip-filters" role="group" aria-label="Filtra percorrenze">
            <button type="button" class="active" data-trip-filter="all" aria-pressed="true">Tutti</button>
            @if (gapsCount > 0)
            {
                <button type="button" data-trip-filter="gaps" aria-pressed="false">Da completare</button>
            }
        </div>

        @if (gapsCount > 0 && firstGap is not null)
        {
            var firstGapStart = firstGap.PreviousEndKilometers.GetValueOrDefault();
            <article class="mobile-gap-summary" id="mobile-gap-summary">
                <div>
                    <span>Tratto da completare</span>
                    <strong>@firstGapStart.ToString("N0", cultura) → @firstGap.StartKilometers.ToString("N0", cultura)</strong>
                    <small>@firstGap.GapKilometers.ToString("N0", cultura) km mancanti</small>
                </div>
                <button type="button" class="mobile-gap-complete">Completa</button>
            </article>
        }

        <section class="mobile-trip-results">
            <h2>Percorrenze</h2>
            <div class="mobile-trip-list" id="mobile-trip-list">
                @foreach (var entry in Model.Dashboard.RecentEntries
                    .OrderByDescending(entry => entry.EndKilometers)
                    .ThenByDescending(entry => entry.TripDate)
                    .ThenByDescending(entry => entry.Id))
                {
                    <a class="mobile-trip-record" data-search="@entry.Route" asp-action="EditMileage" asp-route-id="@entry.Id">
                        <span class="mobile-trip-icon" aria-hidden="true"><svg class="app-icon vehicle-icon" viewBox="0 0 24 24"><path d="M4 15.5h16M5.5 15.5l1.2-5.2A2 2 0 0 1 8.65 8.8h6.7a2 2 0 0 1 1.95 1.5l1.2 5.2M7 12h10"/><circle cx="7" cy="17.5" r="1.5"/><circle cx="17" cy="17.5" r="1.5"/></svg></span>
                        <span class="mobile-trip-copy">
                            <strong>@entry.Route</strong>
                            <small>@entry.TripDate.ToString("dd/MM/yyyy") · @entry.StartKilometers.ToString("N0", cultura) → @entry.EndKilometers.ToString("N0", cultura)</small>
                        </span>
                        <span class="mobile-trip-distance">@entry.DistanceKilometers.ToString("N0", cultura) km</span>
                        <svg class="app-icon mobile-trip-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                    </a>
                }
            </div>
            <p class="mobile-trip-empty" id="mobile-trip-empty" hidden>Nessun tragitto corrisponde alla ricerca.</p>
        </section>
    </section>
</section>
<section class="mobile-home-intro">
    <span>Gestione trasferte</span>
    <h1>Furgone ACLI</h1>
    <p>Mezzo operativo</p>
</section>

<section class="mileage-status-card @(gapsCount == 0 ? "status-ok" : "status-warning")" aria-live="polite">
    <div class="mileage-status-main">
        <span class="card-kicker">Stato contachilometri</span>
        <strong>@(Model.Dashboard.CurrentKilometers?.ToString("N0", cultura) ?? "—") km</strong>
        <span>Ultimo valore raggiunto</span>
    </div>
    <div class="mileage-status-detail">
        @if (gapsCount == 0)
        {
            <strong>✓ Sequenza coerente</strong>
            <span>Non risultano intervalli da verificare.</span>
        }
        else
        {
            <strong>⚠ Sequenza da completare</strong>
            <span>@missingKilometers.ToString("N0", cultura) km da verificare in @gapsCount intervallo@(gapsCount == 1 ? "" : "i").</span>
        }
    </div>
</section>

<section class="period-kilometers-summary desktop-period-kilometers">
    <header><div><span class="card-kicker">Analisi percorrenze</span><h2>Chilometri per periodo</h2></div><span>Anno di riferimento: @summaryYear</span></header>
    <div class="period-kilometers-columns">
        <article>
            <h3>Per mese · @summaryYear</h3>
            @if (monthlyTotals.Length == 0)
            {
                <p>Nessun viaggio nel @summaryYear.</p>
            }
            else
            {
                @foreach (var total in monthlyTotals)
                {
                    <div class="period-kilometers-row"><span>@cultura.DateTimeFormat.GetMonthName(total.Month)</span><small>@total.Trips viaggio@(total.Trips == 1 ? "" : "i")</small><strong>@total.Kilometers.ToString("N0", cultura) km</strong></div>
                }
            }
        </article>
        <article>
            <h3>Per anno</h3>
            @foreach (var total in annualTotals)
            {
                <div class="period-kilometers-row"><span>@total.Year</span><small>@total.Trips viaggio@(total.Trips == 1 ? "" : "i")</small><strong>@total.Kilometers.ToString("N0", cultura) km</strong></div>
            }
        </article>
    </div>
</section>

<div class="mobile-form-backdrop" id="mobile-form-backdrop" hidden></div>

<section class="dashboard-grid mileage-dashboard-grid">
    <article class="dashboard-card summary-card">
        <div class="card-heading-row">
            <div>
                <span class="card-kicker">Situazione attuale</span>
                <h2>Riepilogo del mezzo</h2>
            </div>
            <span class="summary-icon" aria-hidden="true">↗</span>
        </div>

        <div class="summary-main-value">
            <span>Ultimo chilometraggio</span>
            <strong>@(Model.Dashboard.CurrentKilometers?.ToString("N0", cultura) ?? "—") <small>km</small></strong>
        </div>

        <dl class="vehicle-stats mileage-summary-stats">
            <div><dt>Ultima percorrenza</dt><dd>@(Model.Dashboard.LastTripDate?.ToString("dd/MM/yyyy") ?? "Nessun dato")</dd></div>
            <div><dt>Ultimo tragitto</dt><dd>@(Model.Dashboard.RecentEntries.FirstOrDefault()?.Route ?? "—")</dd></div>
            <div><dt>Ultima distanza</dt><dd>@(Model.Dashboard.RecentEntries.FirstOrDefault()?.DistanceKilometers.ToString("N0", cultura) ?? "—") km</dd></div>
            <div><dt>Ultimo conducente</dt><dd>@(Model.Dashboard.RecentEntries.FirstOrDefault()?.InsertedBy ?? "—")</dd></div>
        </dl>
    </article>

    <article class="dashboard-card quick-entry-card" id="quick-entry">
        <div class="card-heading-row">
            <div><span class="card-kicker">Inserimento rapido</span><h2>Nuova percorrenza</h2></div>
            <button type="button" class="mobile-form-close" id="mobile-form-close" aria-label="Chiudi inserimento">
                <svg class="app-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
            </button>
        </div>

        <form asp-controller="Home" asp-action="AddMileage" method="post" class="quick-entry-form" id="mileage-form">
            @Html.AntiForgeryToken()
            <div class="form-row">
                <div class="form-field">
                    <label for="tripDate">Data</label>
                    <input id="tripDate" name="tripDate" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="form-field">
                    <label for="startKilometers">Km iniziali</label>
                    <input id="startKilometers" name="startKilometers" type="number" min="0" step="1" value="@Model.Dashboard.CurrentKilometers" required />
                    <small class="field-help">L’ultimo valore è proposto automaticamente, ma puoi modificarlo.</small>
                </div>
            </div>

            <div id="gap-warning" class="gap-warning" hidden><strong>Attenzione: possibile tratto non registrato</strong><span></span></div>

            <div class="form-field">
                <label for="endKilometers">Km finali</label>
                <input id="endKilometers" name="endKilometers" type="number" min="@(Model.Dashboard.CurrentKilometers ?? 0)" step="1" required />
            </div>

            <div class="distance-preview" id="distance-preview" aria-live="polite"><span>Km percorsi</span><strong>—</strong></div>

            <div class="form-field">
                <label for="route">Tragitto</label>
                <input id="route" name="route" type="text" maxlength="200" placeholder="es. Trento - Rovereto" required />
            </div>

            <div class="form-field">
                <label for="description">Dettaglio <span class="optional-label">facoltativo</span></label>
                <textarea id="description" name="description" maxlength="500" rows="3" placeholder="Motivo della trasferta o note utili"></textarea>
            </div>

            <div class="driver-detail" aria-label="Conducente della percorrenza">
                <span class="driver-detail-label">Conducente</span>
                <strong>@conducenteCorrente</strong>
                <small>Assegnato automaticamente in base all’utente collegato.</small>
            </div>

            <button class="primary-button" type="submit">Salva percorrenza</button>
        </form>
    </article>
</section>

<section class="dashboard-card activity-card trips-card" id="latest-trips">
    <div class="table-toolbar">
        <div>
            <span class="card-kicker">Storico condiviso</span>
            <h2>Ultime percorrenze</h2>
            <p>
                @Model.Dashboard.RecentEntries.Count registrazioni visualizzate
                @if (gapsCount > 0)
                {
                    <span> · <strong>@gapsCount slot vuoti</strong> · @missingKilometers.ToString("N0", cultura) km da verificare</span>
                }
            </p>
        </div>

        <div class="history-tools">
        <form class="history-filter" method="get" asp-action="Index" aria-label="Filtra lo storico per periodo">
            <label>
                <span>Anno</span>
                <select name="year">
                    <option value="">Tutti gli anni</option>
                    @foreach (var availableYear in Model.AvailableYears)
                    {
                        <option value="@availableYear" selected="@(Model.SelectedYear == availableYear ? "selected" : null)">@availableYear</option>
                    }
                </select>
            </label>
            <label>
                <span>Mese</span>
                <select name="month">
                    <option value="">Tutti i mesi</option>
                    @for (var monthNumber = 1; monthNumber <= 12; monthNumber++)
                    {
                        <option value="@monthNumber" selected="@(Model.SelectedMonth == monthNumber ? "selected" : null)">@cultura.DateTimeFormat.GetMonthName(monthNumber)</option>
                    }
                </select>
            </label>
            <button type="submit">Applica</button>
            @if (!Model.IsAllHistory)
            {
                <a asp-action="Index" asp-route-showAll="true">Tutto lo storico</a>
            }
            else
            {
                <a asp-action="Index">Mese corrente</a>
            }
        </form>
            <div class="export-actions" aria-label="Esporta percorrenze">
                <a class="secondary-button export-button" asp-action="ExportMileage" asp-route-format="csv" asp-route-year="@Model.SelectedYear" asp-route-month="@Model.SelectedMonth" asp-route-showAll="@Model.IsAllHistory">CSV / Excel</a>
                <a class="secondary-button export-button" asp-action="ExportMileage" asp-route-format="json" asp-route-year="@Model.SelectedYear" asp-route-month="@Model.SelectedMonth" asp-route-showAll="@Model.IsAllHistory">JSON</a>
                <a class="secondary-button export-button" asp-action="ExportMileage" asp-route-format="xml" asp-route-year="@Model.SelectedYear" asp-route-month="@Model.SelectedMonth" asp-route-showAll="@Model.IsAllHistory">XML</a>
                <a class="secondary-button export-button report-button" asp-action="MileageReport" asp-route-year="@Model.SelectedYear" asp-route-month="@Model.SelectedMonth" asp-route-showAll="@Model.IsAllHistory" target="_blank">Stampa / PDF</a>
            </div>
        </div>
    </div>

    @if (gapsCount > 0)
    {
        <div class="alert alert-error" role="alert">Sono presenti @missingKilometers.ToString("N0", cultura) km non registrati in @gapsCount intervalli. Usa “Inserisci tratto” per completare lo storico.</div>
    }

    @if (Model.Dashboard.RecentEntries.Count == 0)
    {
        <div class="empty-state"><span class="empty-state-icon" aria-hidden="true">↗</span><div><h3>Nessuna percorrenza presente</h3><p>Inserisci la prima percorrenza dal modulo qui sopra.</p></div></div>
    }
    else
    {
        <div class="table-responsive mileage-table-wrapper">
            <table class="mileage-table">
                <thead>
                    <tr>
                        <th>Data</th><th>Tragitto</th><th class="numeric-column">Km iniziali</th><th class="numeric-column">Km finali</th><th class="numeric-column">Percorsi</th><th>Conducente</th><th>Segnalazioni</th><th class="actions-column"><span class="visually-hidden">Azioni</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.Dashboard.RecentEntries
                        .OrderByDescending(entry => entry.EndKilometers)
                        .ThenByDescending(entry => entry.TripDate)
                        .ThenByDescending(entry => entry.Id))
                    {
                        <tr>
                            <td data-label="Data"><time datetime="@entry.TripDate.ToString("yyyy-MM-dd")">@entry.TripDate.ToString("dd/MM/yyyy")</time></td>
                            <td data-label="Tragitto">
                                <strong class="route-name">@entry.Route</strong>
                                @if (!string.IsNullOrWhiteSpace(entry.Description))
                                {
                                    <small class="route-description">@entry.Description</small>
                                }
                            </td>
                            <td data-label="Km iniziali" class="numeric-column">@entry.StartKilometers.ToString("N0", cultura)</td>
                            <td data-label="Km finali" class="numeric-column">@entry.EndKilometers.ToString("N0", cultura)</td>
                            <td data-label="Percorsi" class="numeric-column"><span class="distance-badge">@entry.DistanceKilometers.ToString("N0", cultura) km</span></td>
                            <td data-label="Conducente"><span class="user-badge">@entry.InsertedBy</span></td>
                            <td data-label="Segnalazioni"><span class="no-gap">Registrata</span></td>
                            <td class="actions-column">
                                <a class="table-action" asp-action="EditMileage" asp-route-id="@entry.Id" aria-label="Modifica @entry.Route">Modifica</a>
                            </td>
                        </tr>

                        @if (entry.GapKilometers > 0 && entry.PreviousEndKilometers.HasValue)
                        {
                            var gapStart = entry.PreviousEndKilometers.Value;
                            var gapEnd = entry.StartKilometers;
                            var overlappingEntry = Model.Dashboard.RecentEntries.FirstOrDefault(other =>
                                other.Id != entry.Id &&
                                other.StartKilometers < gapEnd &&
                                other.EndKilometers > gapStart);
                            var previousEntry = Model.Dashboard.RecentEntries.FirstOrDefault(other =>
                                other.Id != entry.Id &&
                                other.EndKilometers == gapStart);
                            var minimumGapDate = previousEntry?.TripDate.Date ?? entry.TripDate.Date;
                            var maximumGapDate = entry.TripDate.Date;

                            <tr class="row-with-gap @(overlappingEntry is null ? "missing-mileage-row" : "overlap-mileage-row")">
                                @if (overlappingEntry is not null)
                                {
                                    <td data-label="Data"><span title="Intervallo già coperto">Da verificare</span></td>
                                    <td data-label="Tragitto"><strong class="route-name">⚠ Sovrapposizione rilevata</strong><small class="route-description">Il tratto @gapStart.ToString("N0", cultura) – @gapEnd.ToString("N0", cultura) è già coperto da @overlappingEntry.StartKilometers.ToString("N0", cultura) – @overlappingEntry.EndKilometers.ToString("N0", cultura).</small></td>
                                    <td data-label="Km iniziali" class="numeric-column">@gapStart.ToString("N0", cultura)</td>
                                    <td data-label="Km finali" class="numeric-column">@gapEnd.ToString("N0", cultura)</td>
                                    <td data-label="Percorsi" class="numeric-column"><span class="gap-badge">Da verificare</span></td>
                                    <td data-label="Conducente"><span class="user-badge">—</span></td>
                                    <td data-label="Segnalazioni"><span class="gap-badge">Non inserire</span></td>
                                    <td class="actions-column"><a class="table-action" asp-action="EditMileage" asp-route-id="@overlappingEntry.Id">Verifica riga</a></td>
                                }
                                else
                                {
                                <td data-label="Data"><span title="Data da verificare">Da verificare</span></td>
                                <td data-label="Tragitto"><strong class="route-name">⚠ Tratto non registrato</strong><small class="route-description">Slot @entry.PreviousEndKilometers.Value.ToString("N0", cultura) – @entry.StartKilometers.ToString("N0", cultura)</small></td>
                                <td data-label="Km iniziali" class="numeric-column">@entry.PreviousEndKilometers.Value.ToString("N0", cultura)</td>
                                <td data-label="Km finali" class="numeric-column">@entry.StartKilometers.ToString("N0", cultura)</td>
                                <td data-label="Percorsi" class="numeric-column"><span class="gap-badge">@entry.GapKilometers.ToString("N0", cultura) km</span></td>
                                <td data-label="Conducente"><span class="user-badge">Da assegnare</span></td>
                                <td data-label="Segnalazioni"><span class="gap-badge">Percorrenza mancante</span></td>
                                    <td class="actions-column"><button type="button" class="table-action fill-gap-button" data-start="@entry.PreviousEndKilometers.Value" data-end="@entry.StartKilometers" data-date="@entry.TripDate.ToString("yyyy-MM-dd")" data-min-date="@minimumGapDate.ToString("yyyy-MM-dd")" data-max-date="@maximumGapDate.ToString("yyyy-MM-dd")">Inserisci tratto</button></td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<nav class="mobile-bottom-nav" aria-label="Navigazione mobile">
    <button type="button" class="active" data-mobile-nav="home" aria-current="page">
        <svg class="app-icon nav-home-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m4 11 8-7 8 7v9h-6v-6h-4v6H4z"/></svg>
        <strong>Home</strong>
    </button>
    <button type="button" data-mobile-nav="trips">
        <svg class="app-icon nav-trips-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="8" width="14" height="11" rx="2"/><path d="M9 8V6.5A1.5 1.5 0 0 1 10.5 5h3A1.5 1.5 0 0 1 15 6.5V8M9 12v4M15 12v4"/></svg>
        <strong>Viaggi</strong>
    </button>
</nav>

@section Scripts
{
    <script>
        (() => {
            const currentKilometers = @(Model.Dashboard.CurrentKilometers?.ToString() ?? "null");
            const form = document.getElementById('mileage-form');
            const tripDate = document.getElementById('tripDate');
            const start = document.getElementById('startKilometers');
            const end = document.getElementById('endKilometers');
            const route = document.getElementById('route');
            const description = document.getElementById('description');
            const preview = document.querySelector('#distance-preview strong');
            const gapWarning = document.getElementById('gap-warning');
            const gapText = gapWarning.querySelector('span');
            const formatter = new Intl.NumberFormat('it-IT');
            const quickEntryCard = document.querySelector('.quick-entry-card');
            const mobileAddMileage = document.getElementById('mobile-add-mileage');
            const mobileFormBackdrop = document.getElementById('mobile-form-backdrop');
            const mobileFormClose = document.getElementById('mobile-form-close');
            const mobileGapAction = document.getElementById('mobile-gap-action');
            const mobileGapComplete = document.querySelector('.mobile-gap-complete');
            const successToast = document.querySelector('.alert-success');
            const mobileScreens = document.querySelectorAll('[data-mobile-screen]');
            const mobileNavButtons = document.querySelectorAll('[data-mobile-nav]');
            const mobileOpenTrips = document.querySelector('[data-mobile-open-trips]');
            const mobileTripSearch = document.getElementById('mobile-trip-search');
            const mobileTripRows = document.querySelectorAll('.mobile-trip-record');
            const mobileTripEmpty = document.getElementById('mobile-trip-empty');
            const mobileTripResults = document.querySelector('.mobile-trip-results');
            const mobileTripFilters = document.querySelectorAll('[data-trip-filter]');
            let activeTripFilter = 'all';

            const setMobileFormOpen = open => {
                quickEntryCard?.classList.toggle('mobile-form-open', open);
                mobileFormBackdrop?.toggleAttribute('hidden', !open);
                document.body.classList.toggle('mobile-sheet-open', open);
                mobileAddMileage?.setAttribute('aria-expanded', String(open));
            };

            mobileAddMileage?.addEventListener('click', () => {
                const isOpen = !(quickEntryCard?.classList.contains('mobile-form-open') ?? false);
                setMobileFormOpen(isOpen);

                if (isOpen) {
                    window.setTimeout(() => end.focus(), 350);
                }
            });

            mobileFormClose?.addEventListener('click', () => setMobileFormOpen(false));
            mobileFormBackdrop?.addEventListener('click', () => setMobileFormOpen(false));
            const openFirstGap = () => document.querySelector('.fill-gap-button')?.click();
            mobileGapAction?.addEventListener('click', openFirstGap);
            mobileGapComplete?.addEventListener('click', openFirstGap);

            const setMobileScreen = screenName => {
                mobileScreens.forEach(screen => {
                    screen.hidden = screen.dataset.mobileScreen !== screenName;
                });
                mobileNavButtons.forEach(button => {
                    const isActive = button.dataset.mobileNav === screenName;
                    button.classList.toggle('active', isActive);
                    if (isActive) {
                        button.setAttribute('aria-current', 'page');
                    } else {
                        button.removeAttribute('aria-current');
                    }
                });
                window.scrollTo({ top: 0, behavior: 'smooth' });
            };

            mobileNavButtons.forEach(button => {
                button.addEventListener('click', () => setMobileScreen(button.dataset.mobileNav));
            });
            mobileOpenTrips?.addEventListener('click', () => setMobileScreen('trips'));

            const applyTripFilters = () => {
                const query = mobileTripSearch?.value.trim().toLocaleLowerCase('it-IT') ?? '';
                let visibleRows = 0;

                mobileTripRows.forEach(row => {
                    const matchesSearch = (row.dataset.search ?? '').toLocaleLowerCase('it-IT').includes(query);
                    const visible = activeTripFilter === 'all' && matchesSearch;
                    row.hidden = !visible;
                    if (visible) visibleRows++;
                });

                if (mobileTripResults) mobileTripResults.hidden = activeTripFilter === 'gaps';
                if (mobileTripEmpty) mobileTripEmpty.hidden = visibleRows > 0 || activeTripFilter !== 'all';
            };

            mobileTripSearch?.addEventListener('input', applyTripFilters);
            mobileTripFilters.forEach(button => {
                button.addEventListener('click', () => {
                    activeTripFilter = button.dataset.tripFilter ?? 'all';
                    mobileTripFilters.forEach(filter => {
                        const isActive = filter === button;
                        filter.classList.toggle('active', isActive);
                        filter.setAttribute('aria-pressed', String(isActive));
                    });
                    applyTripFilters();
                });
            });

            if (successToast) {
                window.setTimeout(() => {
                    successToast.classList.add('is-hiding');
                    successToast.addEventListener('transitionend', () => successToast.remove(), { once: true });
                }, 3200);
            }

            const updateValues = () => {
                const startValue = Number(start.value);
                const endValue = Number(end.value);
                end.min = start.value || '0';
                preview.textContent = Number.isFinite(startValue) && Number.isFinite(endValue) && endValue >= startValue
                    ? formatter.format(endValue - startValue) + ' km'
                    : '—';

                if (currentKilometers !== null && Number.isFinite(startValue) && startValue > currentKilometers) {
                    gapText.textContent = `Dall’ultima percorrenza risultano ${formatter.format(startValue - currentKilometers)} km senza registrazione. Puoi comunque salvare.`;
                    gapWarning.hidden = false;
                } else {
                    gapWarning.hidden = true;
                }
            };

            document.querySelectorAll('.fill-gap-button').forEach(button => {
                button.addEventListener('click', () => {
                    setMobileFormOpen(true);
                    start.value = button.dataset.start;
                    end.value = button.dataset.end;
                    tripDate.min = button.dataset.minDate || '';
                    tripDate.max = button.dataset.maxDate || '';
                    tripDate.value = button.dataset.date;
                    route.value = '';
                    description.value = `Completamento dello slot chilometrico ${formatter.format(Number(button.dataset.start))} - ${formatter.format(Number(button.dataset.end))}.`;
                    updateValues();
                    form.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    window.setTimeout(() => route.focus(), 450);
                });
            });

            start.addEventListener('input', updateValues);
            end.addEventListener('input', updateValues);
            updateValues();
        })();
    </script>
}
