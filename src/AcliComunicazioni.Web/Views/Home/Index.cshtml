@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <span class="eyebrow">Piattaforma interna</span>
    <h1>Benvenuto in AcliComunicazioni</h1>
    <p>La base del nuovo sistema è pronta. Il primo modulo sarà la gestione dei mezzi e dei chilometri.</p>
    <div class="card-grid">
        <article class="module-card">
            <h2>Gestione mezzi</h2>
            <p>Inserimento chilometri, viaggi, storico e controlli.</p>
            <span class="status">Prossimo modulo</span>
        </article>
        <article class="module-card muted">
            <h2>Presenze</h2>
            <p>Modulo previsto per una fase successiva.</p>
        </article>
        <article class="module-card muted">
            <h2>Documenti</h2>
            <p>Archivio e condivisione documentale futura.</p>
        </article>
    </div>
</section>
