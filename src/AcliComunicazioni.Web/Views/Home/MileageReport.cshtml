@model AcliComunicazioni.Web.Models.MileageHistoryViewModel
@{
    ViewData["Title"] = "Report percorrenze";
    var cultura = new System.Globalization.CultureInfo("it-IT");
    var entries = Model.Dashboard.RecentEntries
        .OrderByDescending(entry => entry.TripDate)
        .ThenByDescending(entry => entry.Id)
        .ToArray();
    var totalKilometers = entries.Sum(entry => entry.DistanceKilometers);
    var gaps = entries.Sum(entry => entry.GapKilometers);
    var firstTripDate = entries.Length > 0 ? entries.Min(entry => entry.TripDate) : (DateTime?)null;
    var lastTripDate = entries.Length > 0 ? entries.Max(entry => entry.TripDate) : (DateTime?)null;
    var minimumKilometers = entries.Length > 0 ? entries.Min(entry => entry.StartKilometers) : (int?)null;
    var maximumKilometers = entries.Length > 0 ? entries.Max(entry => entry.EndKilometers) : (int?)null;
    var period = Model.SelectedYear is null
        ? "Tutto lo storico"
        : Model.SelectedMonth is null
            ? $"Anno {Model.SelectedYear}"
            : $"{cultura.DateTimeFormat.GetMonthName(Model.SelectedMonth.Value)} {Model.SelectedYear}";
    int? reportMonth = Model.IsAllHistory ? null : Model.SelectedMonth ?? 0;
}
<style>
        :root { color: #17324d; font-family: Inter, "Segoe UI", Arial, sans-serif; }
        * { box-sizing: border-box; }
        body { margin: 0; background: #eef3f5; font-size: 13px; }
        .report-page-shell { width: 100%; }
        .report { width: 100%; margin: 0; padding: 30px; border: 1px solid #dce6ea; border-radius: 14px; background: #fff; box-shadow: 0 8px 28px rgba(18, 45, 61, .07); }
        .report-header { display: flex; justify-content: space-between; gap: 28px; padding-bottom: 25px; border-bottom: 2px solid #176b7a; }
        .brand { display: flex; align-items: center; gap: 12px; font-weight: 760; }
        .brand-mark { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 10px; background: #176b7a; color: #fff; }
        .eyebrow { color: #176b7a; font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
        h1 { margin: 5px 0 3px; font-size: 24px; letter-spacing: -.035em; }
        .period { margin: 0; color: #617080; font-size: 12px; }
        .report-date { text-align: right; color: #667887; font-size: 11px; }
        .report-date strong { display: block; margin-bottom: 3px; color: #17324d; font-size: 12px; }
        .summary { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; margin: 16px 0; }
        .metric { padding: 10px 12px; border: 1px solid #dbe5e8; border-radius: 8px; background: #f7fafb; }
        .metric span { display: block; color: #6a7a88; font-size: 10px; }
        .metric strong { display: block; margin-top: 4px; color: #17324d; font-size: 16px; letter-spacing: -.025em; }
        .metric small { display: block; margin-top: 3px; color: #748492; font-size: 9px; }
        .report-note { display: flex; align-items: center; gap: 8px; margin: -8px 0 20px; padding: 10px 13px; border: 1px solid #cce0e4; border-radius: 9px; background: #f2fafb; color: #245866; font-size: 12px; }
        .report-note.warning { border-color: #f0d39d; background: #fff9ef; color: #8d5700; }
        .report-note i { width: 8px; height: 8px; border-radius: 50%; background: currentColor; }
        .metric.warning { border-color: #f0d39d; background: #fff9ef; }
        .metric.warning strong { color: #9a5b00; }
        table { width: 100%; border-collapse: collapse; table-layout: fixed; }
        th { padding: 11px 9px; background: #17324d; color: #fff; font-size: 10px; letter-spacing: .04em; text-align: left; text-transform: uppercase; }
        td { padding: 11px 9px; border-bottom: 1px solid #e1e8eb; font-size: 11px; vertical-align: top; overflow-wrap: anywhere; }
        tbody tr:nth-child(even) { background: #f8fafb; }
        .numeric { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
        .route { font-weight: 700; }
        .note { display: block; margin-top: 3px; color: #697987; font-size: 9px; line-height: 1.3; }
        .empty { padding: 32px; border: 1px dashed #cbd7dc; color: #687987; text-align: center; }
        .report-controls { display: flex; align-items: flex-end; justify-content: space-between; gap: 18px; margin: 0 0 18px; padding: 18px 20px; border: 1px solid #dce6ea; border-radius: 13px; background: #fff; box-shadow: 0 5px 18px rgba(18, 45, 61, .05); }
        .report-filter { display: flex; align-items: flex-end; flex-wrap: wrap; gap: 10px; }
        .report-filter label { display: grid; gap: 6px; color: #6a7a88; font-size: 10px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
        .report-filter select { min-width: 150px; height: 42px; padding: 0 34px 0 12px; border: 1px solid #ccdadd; border-radius: 8px; color: #17324d; background: #fff; font: inherit; font-size: 13px; text-transform: none; }
        .report-filter a { display: inline-flex; align-items: center; min-height: 42px; padding: 0 4px; color: #176b7a; font-weight: 750; text-decoration: none; }
        .actions { display: flex; align-items: center; justify-content: flex-end; flex-wrap: wrap; gap: 10px; }
        button, .download-pdf { display: inline-flex; align-items: center; justify-content: center; padding: 11px 16px; border: 0; border-radius: 8px; background: #176b7a; color: #fff; font: inherit; font-weight: 700; line-height: normal; text-decoration: none; cursor: pointer; }
        button.secondary { background: #fff; color: #17324d; border: 1px solid #ccdadd; }
        .report-footer { margin-top: 22px; padding-top: 12px; border-top: 1px solid #dfe7ea; color: #71808b; font-size: 10px; }
        @@media screen {
            .report {
                width: 100%;
                min-height: 0;
            }
        }

        @@media screen and (max-width: 760px) {
            .report-controls { display: grid; align-items: stretch; padding: 14px; }
            .report-filter { display: grid; grid-template-columns: 1fr 1fr; }
            .report-filter label, .report-filter select { width: 100%; min-width: 0; }
            .report-filter button { align-self: end; }
            .actions { justify-content: stretch; }
            .actions button, .actions .download-pdf { flex: 1; }
        }

        @@media screen and (max-width: 520px) {
            .actions button, .actions .download-pdf { min-height: 42px; padding: 9px 12px; }
            .report { min-height: 0; padding: 18px 16px; }
            .report-header { display: block; padding-bottom: 16px; }
            .report-date { margin-top: 14px; text-align: left; }
            .summary { grid-template-columns: 1fr; }
            .report-note { margin-top: 0; line-height: 1.4; }
            table, tbody, tr, td { display: block; width: 100%; }
            thead { display: none; }
            tbody { display: grid; gap: 10px; }
            tbody tr { padding: 7px 12px; border: 1px solid #dbe5e8; border-radius: 9px; background: #fff !important; }
            td { display: grid; grid-template-columns: 105px minmax(0, 1fr); gap: 10px; padding: 7px 0; border-bottom: 1px solid #edf1f3; font-size: 11px; text-align: left !important; }
            td:last-child { border-bottom: 0; }
            td::before { content: attr(data-label); color: #6a7a88; font-size: 9px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; }
            .note { font-size: 9px; }
        }

        @@media print {
            @@page { size: A4 portrait; margin: 10mm; }
            body { background: #fff; }
            .app-sidebar, .topbar, .report-controls { display: none !important; }
            .app-shell, .app-workspace { display: block !important; }
            .main-content { width: 100% !important; max-width: none !important; margin: 0 !important; padding: 0 !important; }
            .report-page-shell { width: 100%; }
            .report { width: 100%; margin: 0; padding: 0; box-shadow: none; }
            .report-header { padding-bottom: 12px; }
            .report { font-size: 10pt; }
            .brand { font-size: 11pt; }
            h1 { font-size: 21pt; }
            .period, .report-date { font-size: 9pt; }
            .summary { margin: 14px 0; }
            .metric { padding: 9px 10px; }
            .metric span { font-size: 8.5pt; }
            .metric strong { font-size: 13pt; }
            .metric small { font-size: 8pt; }
            .report-note { margin: -4px 0 13px; padding: 8px 10px; font-size: 8.8pt; }
            th { padding: 7px 5px; font-size: 8.5pt; }
            td { padding: 7px 5px; font-size: 9.5pt; line-height: 1.25; }
            .route { font-size: 10pt; }
            .note { font-size: 8pt; }
            th:nth-child(1) { width: 11%; }
            th:nth-child(2) { width: 31%; }
            th:nth-child(3), th:nth-child(4) { width: 14%; }
            th:nth-child(5) { width: 12%; }
            th:nth-child(6) { width: 18%; }
            tr { break-inside: avoid; }
        }
    </style>
<div class="report-page-shell">
    <div class="report-controls">
        <form class="report-filter" method="get" asp-action="MileageReport" aria-label="Filtra il report per periodo">
            <label>
                <span>Anno</span>
                <select name="year" onchange="this.form.requestSubmit()">
                    @foreach (var availableYear in Model.AvailableYears)
                    {
                        <option value="@availableYear" selected="@(Model.SelectedYear == availableYear ? "selected" : null)">@availableYear</option>
                    }
                </select>
            </label>
            <label>
                <span>Mese</span>
                <select name="month" onchange="this.form.requestSubmit()">
                    <option value="0" selected="@(Model.SelectedMonth is null && !Model.IsAllHistory ? "selected" : null)">Tutti i mesi</option>
                    @for (var monthNumber = 1; monthNumber <= 12; monthNumber++)
                    {
                        <option value="@monthNumber" selected="@(Model.SelectedMonth == monthNumber ? "selected" : null)">@cultura.DateTimeFormat.GetMonthName(monthNumber)</option>
                    }
                </select>
            </label>
            <noscript><button type="submit">Mostra</button></noscript>
            @if (!Model.IsAllHistory)
            {
                <a asp-action="MileageReport" asp-route-showAll="true">Tutto lo storico</a>
            }
            else
            {
                <a asp-action="MileageReport">Mese corrente</a>
            }
        </form>
        <div class="actions">
            <button type="button" class="secondary" onclick="window.close()">Chiudi</button>
            <a class="download-pdf"
               asp-action="DownloadMileagePdf"
               asp-route-year="@Model.SelectedYear"
               asp-route-month="@reportMonth"
               asp-route-showAll="@Model.IsAllHistory">Scarica PDF</a>
        </div>
    </div>
    <main class="report">
        <header class="report-header">
            <div>
                <div class="brand"><span class="brand-mark">AC</span> AcliComunicazioni</div>
                <span class="eyebrow">Gestione trasferte</span>
                <h1>Report percorrenze</h1>
                <p class="period">@period</p>
            </div>
            <div class="report-date"><strong>Estratto il @DateTime.Today.ToString("dd/MM/yyyy")</strong>Storico condiviso del mezzo</div>
        </header>

        <section class="summary" aria-label="Riepilogo del periodo">
            <article class="metric"><span>Registrazioni</span><strong>@entries.Length</strong><small>@(firstTripDate?.ToString("dd/MM/yyyy") ?? "—") – @(lastTripDate?.ToString("dd/MM/yyyy") ?? "—")</small></article>
            <article class="metric"><span>Chilometri percorsi</span><strong>@totalKilometers.ToString("N0", cultura) km</strong><small>Totale nel periodo</small></article>
            <article class="metric"><span>Intervallo contachilometri</span><strong>@(minimumKilometers?.ToString("N0", cultura) ?? "—") – @(maximumKilometers?.ToString("N0", cultura) ?? "—")</strong><small>Km iniziali e finali</small></article>
            <article class="metric @(gaps > 0 ? "warning" : "")"><span>Da verificare</span><strong>@gaps.ToString("N0", cultura) km</strong><small>@(gaps > 0 ? "Sono presenti intervalli mancanti" : "Sequenza coerente nel periodo")</small></article>
        </section>

        <p class="report-note @(gaps > 0 ? "warning" : "")"><i aria-hidden="true"></i>@(gaps > 0 ? "Attenzione: il report segnala chilometri non registrati nel periodo selezionato." : "Controllo completato: non risultano intervalli chilometrici mancanti nel periodo.")</p>

        @if (entries.Length == 0)
        {
            <p class="empty">Nessuna percorrenza nel periodo selezionato.</p>
        }
        else
        {
            <table>
                <thead>
                    <tr><th>Data</th><th>Tragitto</th><th class="numeric">Km iniziali</th><th class="numeric">Km finali</th><th class="numeric">Percorsi</th><th>Conducente</th></tr>
                </thead>
                <tbody>
                @foreach (var entry in entries)
                {
                    <tr>
                        <td data-label="Data">@entry.TripDate.ToString("dd/MM/yyyy")</td>
                        <td data-label="Tragitto"><span class="route">@entry.Route</span>@if (!string.IsNullOrWhiteSpace(entry.Description)) { <span class="note">@entry.Description</span> }</td>
                        <td data-label="Km iniziali" class="numeric">@entry.StartKilometers.ToString("N0", cultura)</td>
                        <td data-label="Km finali" class="numeric">@entry.EndKilometers.ToString("N0", cultura)</td>
                        <td data-label="Percorsi" class="numeric">@entry.DistanceKilometers.ToString("N0", cultura) km</td>
                        <td data-label="Conducente">@entry.InsertedBy</td>
                    </tr>
                }
                </tbody>
            </table>
        }

        <footer class="report-footer">Report generato da AcliComunicazioni · Periodo: @period</footer>
    </main>
</div>
