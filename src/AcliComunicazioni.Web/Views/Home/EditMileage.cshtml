@model AcliComunicazioni.Application.Mileage.MileageEntry

@{
    ViewData["Title"] = "Modifica percorrenza";
    var cultura = new System.Globalization.CultureInfo("it-IT");
}

<section class="page-heading compact-heading">
    <div>
        <span class="eyebrow">Storico percorrenze</span>
        <h1>Modifica percorrenza</h1>
        <p>Aggiorna i dati della registrazione selezionata.</p>
    </div>
    <a class="secondary-button back-button" asp-action="Index" asp-fragment="latest-trips">← Torna allo storico</a>
</section>

<section class="dashboard-card edit-card">
    <form asp-action="EditMileage" method="post" class="edit-form" id="edit-mileage-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-row">
            <div class="form-field">
                <label for="tripDate">Data</label>
                <input id="tripDate" name="tripDate" type="date"
                       max="@DateTime.Today.ToString("yyyy-MM-dd")"
                       value="@Model.TripDate.ToString("yyyy-MM-dd")" required />
            </div>

            <div class="form-field">
                <label for="route">Tragitto</label>
                <input id="route" name="route" type="text" maxlength="200"
                       value="@Model.Route" required />
            </div>
        </div>

        <div class="form-row">
            <div class="form-field">
                <label for="startKilometers">Km partenza</label>
                <input id="startKilometers" name="startKilometers" type="number"
                       min="0" step="1" value="@Model.StartKilometers" required />
            </div>

            <div class="form-field">
                <label for="endKilometers">Km arrivo</label>
                <input id="endKilometers" name="endKilometers" type="number"
                       min="@Model.StartKilometers" step="1" value="@Model.EndKilometers" required />
            </div>
        </div>

        <div class="distance-preview" id="distance-preview" aria-live="polite">
            <span>Km percorsi</span>
            <strong>@Model.DistanceKilometers km</strong>
        </div>

        <div class="form-field">
            <label for="description">Descrizione <span class="optional-label">facoltativa</span></label>
            <textarea id="description" name="description" maxlength="500" rows="4">@Model.Description</textarea>
        </div>

        <div class="form-actions">
            <a class="secondary-button cancel-button" asp-action="Index" asp-fragment="latest-trips">Annulla</a>
            <button class="primary-button save-button" type="submit">Salva modifiche</button>
        </div>
    </form>

    <div class="delete-section">
        <form asp-action="DeleteMileage" method="post" id="delete-mileage-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button class="delete-text-button" type="submit">Elimina questa percorrenza</button>
        </form>
        <small>La percorrenza verrà rimossa dalla vista, ma resterà conservata nello storico del database.</small>
    </div>
</section>

@section Scripts
{
    <script>
        (() => {
            const start = document.getElementById('startKilometers');
            const end = document.getElementById('endKilometers');
            const preview = document.querySelector('#distance-preview strong');
            const deleteForm = document.getElementById('delete-mileage-form');
            const formatter = new Intl.NumberFormat('it-IT');

            const updateDistance = () => {
                const startValue = Number(start.value);
                const endValue = Number(end.value);
                end.min = start.value || '0';

                if (Number.isFinite(startValue) && Number.isFinite(endValue) && endValue >= startValue) {
                    preview.textContent = formatter.format(endValue - startValue) + ' km';
                } else {
                    preview.textContent = '—';
                }
            };

            deleteForm.addEventListener('submit', event => {
                const message = `Eliminare questa percorrenza?\n\nData: @Model.TripDate.ToString("dd/MM/yyyy")\nTragitto: @Model.Route\nKm: @Model.StartKilometers.ToString("N0", cultura) → @Model.EndKilometers.ToString("N0", cultura)\n\nIl record resterà conservato nello storico del database.`;

                if (!window.confirm(message)) {
                    event.preventDefault();
                }
            });

            start.addEventListener('input', updateDistance);
            end.addEventListener('input', updateDistance);
        })();
    </script>
}
